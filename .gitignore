# Python
__pycache__/
*.egg-info/
.venv/
.pytest_cache/

# Data and build results (large, machine-specific, regenerated by the app)
cache/
out/

# Machine-specific config and full XPTools downloads (DSFTool itself is bundled in tools/xptools/)
xptools_*/
config/local.toml
